# any claude.ai chat subscription.
ANTHROPIC_API_KEY=sk-ant-your-key-here

DIALCOACH_DB_VERSION=v1

# Model used for fast, cheap, in-call suggestions and playbook checks.
DIALCOACH_LIVE_MODEL=claude-haiku-4-5

# Model used for higher-quality post-call summaries and log drafting.
DIALCOACH_SUMMARY_MODEL=claude-sonnet-4-5

# Path to the local SQLite database file.
DIALCOACH_DB_PATH=

# Path to the folder where call audio recordings are stored.
DIALCOACH_AUDIO_DIR=./data/audio

# Path to your existing Campaign_Tracker.xlsx (per the project's outreach workflow).
DIALCOACH_TRACKER_PATH=./data/Campaign_Tracker.xlsx